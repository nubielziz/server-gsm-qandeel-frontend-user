{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5175",
    "build": "next build",
    "start": "next start -p 5176",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:api:check": "node scripts/gen-api-types.mjs --check",
    "check": "npm run gen:api:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "markdown-it": "15.0.3",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/turbopack": "^4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
