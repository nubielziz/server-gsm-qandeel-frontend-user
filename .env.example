# Copy to .env.development.local (git-ignored) and adjust.

# Where the GSM API listens (server-side calls and the /client, /store/v1 rewrites).
# :3000 = the owner's API. :3100 = the isolated demo-seeded copy started by scripts/dev-backend.sh.
GSM_API_ORIGIN=http://localhost:3000

# Cloudflare Turnstile site key (public). Leave empty in development: the always-pass test key is used,
# which yields the dummy token the backend's dev verifier accepts. Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
