# Copy to .env.development.local (git-ignored) and adjust. Never commit a real .env file; `.env*` never enters the
# Docker image.

# Where the GSM API listens (server-side calls and, by default, the /client and /store/v1 rewrites).
# :3000 = the owner's API. :3100 = the isolated demo-seeded copy started by scripts/dev-backend.sh.
# In a Docker build this must be an address the BUILD can reach: cached public reads run during `next build`.
GSM_API_ORIGIN=http://localhost:3000

# BUILD-TIME. Where the /client and /store/v1 rewrites point. Rewrite destinations are fixed by `next build`, so a
# container that reaches the API under another name than the build does sets it (compose: http://api:3000).
# Unset or empty = GSM_API_ORIGIN.
# GSM_API_REWRITE_ORIGIN=

# BUILD-TIME. `standalone` makes `next build` emit .next/standalone for the Docker image (the Dockerfile sets it).
# Leave unset for `next dev`, `next build` and `next start`.
# NEXT_OUTPUT=

# Cloudflare Turnstile site key (public, BUILD-TIME like every NEXT_PUBLIC_* value). Leave empty in development: the
# always-pass test key is used, which yields the dummy token the backend's dev verifier accepts. Required in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public address of the site (canonical links, sitemap, robots, social cards). Production: https://<shop host>.
# Default http://localhost:5175.
# NEXT_PUBLIC_SITE_URL=

# Time zone for displayed dates (an IANA name). Default UTC, the API's own zone.
# NEXT_PUBLIC_TIME_ZONE=

# Public address of the API, shown in the help of the merchant portal's API keys page. Default: empty.
# NEXT_PUBLIC_API_PUBLIC_URL=
